{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommitTypeAll(deps)",
    ":semanticCommitScopeDisabled",
    ":enablePreCommit"
  ],
  "timezone": "Europe/Berlin",
  "assignees": ["dmnktoe"],
  "reviewers": ["dmnktoe"],
  "labels": ["dependencies"],
  "dependencyDashboard": false,
  "vulnerabilityAlerts": { "labels": ["security"] },
  "packageRules": [
    {
      "description": "Keep ranges, move the floor, so an in-range release still surfaces as a PR",
      "matchPackageNames": ["*"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Peers and engines keep their ranges",
      "matchDepTypes": ["engines", "peerDependencies"],
      "rangeStrategy": "replace"
    },
    {
      "description": "Dev tooling lands in one PR, pnpm catalog included",
      "matchDepTypes": ["devDependencies", "pnpm.catalog.default"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies"
    },
    {
      "description": "Production deps land in one PR",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "production dependencies"
    },
    {
      "description": "Runtime packages that live in the pnpm catalog stay with production",
      "matchDepTypes": ["pnpm.catalog.default"],
      "matchPackageNames": ["@storyblok/react"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "production dependencies"
    },
    {
      "description": "React and Next move in lockstep, types included",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "next",
        "@next/**"
      ],
      "groupName": "react + next"
    },
    {
      "description": "CI actions move together",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "addLabels": ["ci"]
    },
    {
      "description": "Node and pnpm move together",
      "matchDepNames": ["node", "pnpm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "toolchain"
    },
    {
      "description": "Majors need a human",
      "matchUpdateTypes": ["major"],
      "addLabels": ["manual-review"]
    }
  ]
}
