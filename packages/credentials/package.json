    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@httpjpg/cli-style": "workspace:*",
    "dotenv": "catalog:",
    "psn-api": "^2.18.0"
  },
  "devDependencies": {
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
