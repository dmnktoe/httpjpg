{
  "name": "@httpjpg/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 3002",
    "dev:https": "storybook dev -p 3002",
    "build": "turbo run build --filter=@httpjpg/ui && storybook build",
    "preview": "storybook preview",
    "chromatic": "chromatic",
    "test:visual": "bash ./scripts/visual-docker.sh",
    "test:visual:update": "bash ./scripts/visual-docker.sh --update-snapshots",
    "test:visual:smoke": "playwright test --ignore-snapshots",
    "type-check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@httpjpg/consent": "workspace:*",
    "@httpjpg/now-playing": "workspace:*",
    "@httpjpg/spotify": "workspace:*",
    "@httpjpg/storyblok-richtext": "workspace:*",
    "@httpjpg/storyblok-utils": "workspace:*",
    "@httpjpg/tokens": "workspace:*",
    "@httpjpg/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "chromatic": "^18.1.0",
    "storybook": "^10.5.7",
    "typescript": "catalog:",
    "vite": "^8.2.1"
  }
}
