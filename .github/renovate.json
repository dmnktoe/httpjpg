{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommitTypeAll(deps)",
    ":semanticCommitScopeDisabled",
    ":enablePreCommit"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["before 10am on monday"],
  "assignees": ["dmnktoe"],
  "reviewers": ["dmnktoe"],
  "labels": ["dependencies"],
  "dependencyDashboard": false,
  "prConcurrentLimit": 5,
  "lockFileMaintenance": { "enabled": false },
  "vulnerabilityAlerts": { "labels": ["security"] },
  "packageRules": [
    {
      "description": "Keep ranges, move the floor, so an in-range release still surfaces as a PR",
      "matchPackageNames": ["*"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Peers and engines keep their ranges",
      "matchDepTypes": ["engines", "peerDependencies"],
      "rangeStrategy": "replace"
    },
    {
      "description": "All non-major npm updates in one PR, including pnpm catalog keys that are not devDependencies",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "React and Next move in lockstep, types included",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "next",
        "@next/**"
      ],
      "groupName": "react + next"
    },
    {
      "description": "CI actions move together",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "addLabels": ["ci"]
    },
    {
      "description": "No standalone digest-bump PRs for GitHub Actions — SHA pins refresh on version bumps",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Majors need a human",
      "matchUpdateTypes": ["major"],
      "addLabels": ["manual-review"]
    }
  ]
}
