{
  "name": "@httpjpg/credentials",
  "version": "0.0.0",
  "private": true,
  "description": "CLI helpers to mint and verify the Spotify and PSN credentials the widgets run on",
  "bin": {
    "credentials-psn": "./scripts/psn.ts",
    "credentials-spotify": "./scripts/spotify.ts"
  },
  "type": "module",
  "scripts": {
    "spotify": "tsx scripts/spotify.ts",
    "psn": "tsx scripts/psn.ts",
