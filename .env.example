# Copy to `.env.local` at the repo root (NOT inside apps/portfolio).
# `packages/env` validates these via Zod at startup; missing required
# values fail fast. NEVER commit `.env.local`.

# -- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -- Storyblok ----------------------------------------------------------------
# Public + Preview tokens: Space Settings → Access Tokens
NEXT_PUBLIC_STORYBLOK_TOKEN=""
NEXT_PUBLIC_STORYBLOK_VERSION="published"
STORYBLOK_PREVIEW_TOKEN=""
# Generate both secrets with `openssl rand -base64 32`
STORYBLOK_PREVIEW_SECRET=""
STORYBLOK_REVALIDATE_SECRET=""
# Management token + space ID — only required when running sync scripts locally.
# Account Settings → Personal Access Tokens.
STORYBLOK_MANAGEMENT_TOKEN=""
STORYBLOK_SPACE_ID=""

# -- Sentry -------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Source-map upload uses SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT —
# CI-only GitHub secrets, not part of the runtime env contract.
# Set to 1 to also report errors during local dev (server + client).
# SENTRY_ENABLE_IN_DEV=1
# NEXT_PUBLIC_SENTRY_ENABLE_IN_DEV=1

# -- Spotify (Now Playing widget) ---------------------------------------------
# Dashboard → Create App, then register http://127.0.0.1:8888/callback as a
# redirect URI and mint the refresh token with `pnpm creds:spotify --write`.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REFRESH_TOKEN=""

# -- PlayStation (trophy widget) ----------------------------------------------
# NPSSO cookies expire after ~60 days; renew with `pnpm creds:psn --write` and
# check the one you have with `pnpm creds:psn --check`. Empty disables the widget.
PSN_NPSSO=""

# -- Google Analytics ---------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# -- Umami --------------------------------------------------------------------
# Website ID from the Umami dashboard; empty disables the tracker.
NEXT_PUBLIC_UMAMI_ID=""
# Override only when self-hosting (defaults to Umami Cloud).
# NEXT_PUBLIC_UMAMI_SRC="https://cloud.umami.is/script.js"
# API key for the visitor-counter widget (Umami Cloud → Settings → API Keys).
# Empty disables the counter; the widget also needs NEXT_PUBLIC_UMAMI_ID.
UMAMI_API_KEY=""
# Override only when self-hosting (defaults to Umami Cloud's API).
# UMAMI_API_URL="https://api.umami.is/v1"
# Start of the counted window; anything unparseable falls back to 2024-01-01.
# UMAMI_STATS_SINCE="2024-01-01"

# -- TweetAPI (latest X post widget) ------------------------------------------
# Key from the TweetAPI dashboard; empty disables the widget. The handle itself
# lives in the Storyblok config story as `x_username`.
TWEETAPI_KEY=""
# Override only when pointing at a different TweetAPI deployment.
# TWEETAPI_API_URL="https://api.tweetapi.com/tw-v2"

# -- Dev ----------------------------------------------------------------------
NODE_ENV=development
# SKIP_ENV_VALIDATION=1
